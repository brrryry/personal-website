#!/bin/sh

# Check if gh CLI is installed
if command -v gh >/dev/null 2>&1; then
  # Check if gh CLI is authenticated
  if gh auth status >/dev/null 2>&1; then
    echo "🔐 Updating GitHub secret ENV_FILE from local .env..."
    if gh secret set ENV_FILE < .env; then
      echo "✅ GitHub secret ENV_FILE updated successfully."
    else
      echo "❌ Failed to update GitHub secret ENV_FILE."
    fi
  else
    echo "⚠️ Warning: Not logged in to gh CLI. Skipping ENV_FILE update."
  fi
else
  echo "⚠️ Warning: gh CLI not installed. Skipping ENV_FILE update."
fi
